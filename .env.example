# SQLite database
DATABASE_URL="file:./dev.db"

# Paystack — get keys from https://dashboard.paystack.com/#/settings/developer
# Use test keys for development (pk_test_... and sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Your store name (shown in Paystack checkout)
NEXT_PUBLIC_STORE_NAME="Curated Thrift Co."

# Public site URL (for Paystack callback) — use http://localhost:3000 in dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin panel password — change this!
ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs the admin session cookie + CSRF token — set to a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# AI customer-care assistant (optional).
# Without a key, the assistant still answers using built-in rules
# (products, prices, sizes, delivery, payment, contact).
# Add an OpenAI key to enable smart conversational replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Social links (optional — shown in footer; also editable in admin)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourstore
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@yourstore
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678

# Web push (new-arrival phone notifications). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
